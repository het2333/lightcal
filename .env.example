# Copy to .env and supply your own provider key. Never commit .env.
LLM_PROVIDER=qwen
LLM_FALLBACK_ENABLED=false
QWEN_API_KEY=
QWEN_MODEL=qwen-vl-plus
QWEN_TEMPERATURE=0

# Current photo route: one vision request for food, weight and nutrition.
PHOTO_ANALYSIS_MODE=direct_nutrition
PHOTO_IMAGE_MAX_DIM=1024
PHOTO_IMAGE_JPEG_QUALITY=82
PHOTO_ANALYSIS_CACHE_ENABLED=true
PHOTO_ANALYSIS_FLYWHEEL_ENABLED=false
PHOTO_NUTRITION_REVIEW_PROVIDER=deepseek
DEEPSEEK_API_KEY=

# Other supported providers (optional).
MIMO_API_KEY=
MIMO_MODEL=mimo-v2.5
ZHIPU_API_KEY=
DOUBAO_API_KEY=
GEMINI_API_KEY=

# Optional, separately deployed GPU depth service.
DEPTH_PIPELINE_ENABLED=false
DEPTH_PIPELINE_BASE_URL=
DEPTH_PIPELINE_API_KEY=
DEPTH_PIPELINE_CONNECT_TIMEOUT=8
DEPTH_PIPELINE_READ_TIMEOUT=240
DEPTH_PIPELINE_WRITE_TIMEOUT=240

HOST=127.0.0.1
PORT=8001
